#: ui/Account.qml:31
#, kde-format
msgid "Remove"
msgstr "წაშლა"

#: ui/Account.qml:41
#, kde-format
msgid "These applications are authorized to use %1:"
msgstr "ამ აპლიკაციებს აქვთ უფლება, გამოიყენონ %1:"

#: ui/Account.qml:63
#, kde-format
msgid "No applications are authorized to use %1"
msgstr "აპლიკაციები, რომლებსაც აქვთ უფლება, გამოიყენონ %1, არ არსებობს"

#: ui/AddAccountDialog.qml:23
#, kde-format
msgid "Create Account"
msgstr "ანგარიშის შექმნა"

#: ui/App.qml:28
#, kde-format
msgid "Give access to relevant apps:"
msgstr "წვდომის მინიჭება შესაბამისი პროგრამებისთვის:"

#: ui/App.qml:68
#, kde-format
msgid "No relevant apps found"
msgstr "შესაბამისი პროგრამები აღმოჩენილი არაა"

#: ui/App.qml:74
#, kde-format
msgid "Finish"
msgstr "დასრულება"

#: ui/Error.qml:25
#, kde-format
msgid "Setup failed: %1"
msgstr "მორგება ჩავარდა: %1"

#: ui/Error.qml:29
#, kde-format
msgid "Ok"
msgstr "დიახ"

#: ui/main.qml:26
#, kde-format
msgid "Add Account…"
msgstr "ანგარიშის დამატება…"

#: ui/main.qml:44
#, kde-kuit-format
msgctxt "@info:usagetip"
msgid ""
"This feature is under development and is still considered experimental. "
"Report all issues <link url='%1'>here</link>."
msgstr ""
"ეს ფუნქცია ჯერ დასრულებული არაა და ის ჯერ კიდევ ექსპერიმენტულად ითვლება. "
"შეცდომების შესახებ მოგვწერეთ <link url='%1'>აქ</link>."

#: ui/main.qml:60
#, kde-format
msgid "Online accounts service is not running"
msgstr "ონლაინ-ანგარიშების სერვისი გაშვებული არაა"

#: ui/main.qml:67
#, kde-format
msgid "No accounts configured"
msgstr "მორგებული ანგარიშების გარეშე"
