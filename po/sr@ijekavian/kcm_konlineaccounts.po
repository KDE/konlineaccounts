#, kde-format
msgid "Remove"
msgstr "Уклони"

#: ui/Account.qml:41
#, kde-format
msgctxt "%1 is the name of an online account"
msgid "These applications are authorized to use %1:"
msgstr "Ови програми су овлашћени да користе %1:"

#: ui/Account.qml:63
#, kde-format
msgctxt "%1 is the name of an online account"
msgid "No applications are authorized to use %1"
msgstr "Ниједан програм није овлашћен да користи %1"

