#: ui/main.qml:44
#, kde-kuit-format
msgctxt "@info:usagetip"
msgid ""
"This feature is under development and is still considered experimental. "
"Report all issues <link url='%1'>here</link>."
msgstr ""
"Ова могућност је у развоју и још се сматра експерименталном. Све проблеме "
"пријавите <link url='%1'>овдје</link>."

#: ui/main.qml:60
#, kde-format
msgid "Online accounts service is not running"
msgstr "Сервис налога на вези није покренут"

