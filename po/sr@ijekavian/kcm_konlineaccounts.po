#, kde-format
msgctxt "@title:window"
msgid "Create Account"
msgstr "Стварање налога"

#: ui/App.qml:28
#, kde-format
msgctxt "as in 'allow relevant apps to access your account'"
msgid "Give access to relevant apps:"
msgstr "Дајте приступ одговарајућим програмима:"

#: ui/App.qml:68
#, kde-format
msgid "No relevant apps found"
msgstr "Нису нађени одговарајући програми"

#: ui/App.qml:74
#, kde-format
msgctxt "@action:button"
msgid "Finish"
msgstr "Заврши"

#: ui/Error.qml:25
#, kde-format
msgctxt "%1 is an error message"
msgid "Setup failed: %1"
msgstr "Подешавање није успјело: %1"

#: ui/Error.qml:29
#, kde-format
msgctxt "@action:button"
msgid "OK"
msgstr "У реду"

#: ui/main.qml:26
#, kde-format
msgid "Add Account…"
