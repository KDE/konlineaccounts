#: ui/Account.qml:31
#, kde-format
msgid "Remove"
msgstr "削除"

#: ui/Account.qml:41
#, kde-format
msgctxt "%1 is the name of an online account"
msgid "These applications are authorized to use %1:"
msgstr "以下のアプリケーションは %1 を使用する権限があります。"

#: ui/Account.qml:63
#, kde-format
msgctxt "%1 is the name of an online account"
msgid "No applications are authorized to use %1"
msgstr "%1 の使用を許可されたアプリケーションはありません"

#: ui/AddAccountDialog.qml:23
#, kde-format
msgctxt "@title:window"
msgid "Create Account"
msgstr "アカウント作成"

#: ui/App.qml:28
#, kde-format
msgctxt "as in 'allow relevant apps to access your account'"
msgid "Give access to relevant apps:"
msgstr "関連アプリにアクセス権を付与できます。"

#: ui/App.qml:68
#, kde-format
msgid "No relevant apps found"
msgstr "関連するアプリが見つかりませんでした"

#: ui/App.qml:74
#, kde-format
msgctxt "@action:button"
msgid "Finish"
msgstr "完了"

#: ui/Error.qml:25
#, kde-format
msgctxt "%1 is an error message"
msgid "Setup failed: %1"
msgstr "セットアップに失敗しました。エラー内容: %1"

#: ui/Error.qml:29
#, kde-format
msgctxt "@action:button"
msgid "OK"
msgstr "OK"

#: ui/main.qml:26
#, kde-format
msgid "Add Account…"
msgstr "アカウントを追加…"

#: ui/main.qml:44
#, kde-kuit-format
msgctxt "@info:usagetip"
msgid ""
"This feature is under development and is still considered experimental. "
"Report all issues <link url='%1'>here</link>."
msgstr ""
"この機能は現在開発中であり、実験的機能となっています。不具合報告は <link "
"url='%1'>こちら</link> からお願いします。"

#: ui/main.qml:60
#, kde-format
msgid "Online accounts service is not running"
msgstr "オンラインアカウントサービスが実行されていません"

#: ui/main.qml:67
#, kde-format
msgid "No accounts configured"
msgstr "アカウントが設定されていません"
