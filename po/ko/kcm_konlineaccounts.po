#: ui/Account.qml:31
#, kde-format
msgid "Remove"
msgstr "삭제"

#: ui/Account.qml:41
#, kde-format
msgctxt "%1 is the name of an online account"
msgid "These applications are authorized to use %1:"
msgstr "다음 앱에서 %1 계정을 사용할 수 있습니다:"

#: ui/Account.qml:63
#, kde-format
msgctxt "%1 is the name of an online account"
msgid "No applications are authorized to use %1"
msgstr "%1 계정을 사용할 수 있도록 승인된 앱 없음"

#: ui/AddAccountDialog.qml:23
#, kde-format
msgctxt "@title:window"
msgid "Create Account"
msgstr "계정 만들기"

#: ui/App.qml:28
#, kde-format
msgctxt "as in 'allow relevant apps to access your account'"
msgid "Give access to relevant apps:"
msgstr "연관된 앱에 접근 허용:"

#: ui/App.qml:68
#, kde-format
msgid "No relevant apps found"
msgstr "관련 앱을 찾을 수 없음"

#: ui/App.qml:74
#, kde-format
msgctxt "@action:button"
msgid "Finish"
msgstr "완료"

#: ui/Error.qml:25
#, kde-format
msgctxt "%1 is an error message"
msgid "Setup failed: %1"
msgstr "설정 실패: %1"

#: ui/Error.qml:29
#, kde-format
msgctxt "@action:button"
msgid "OK"
msgstr "확인"

#: ui/main.qml:26
#, kde-format
msgid "Add Account…"
msgstr "계정 추가…"

#: ui/main.qml:44
#, kde-kuit-format
msgctxt "@info:usagetip"
msgid ""
"This feature is under development and is still considered experimental. "
"Report all issues <link url='%1'>here</link>."
msgstr ""
"이 기능은 개발 중이며 실험적인 상태에 있습니다. 모든 문제점을 <link url='%1'>"
"여기</link>에 보고해 주십시오."

#: ui/main.qml:60
#, kde-format
msgid "Online accounts service is not running"
msgstr "온라인 계정 서비스가 실행 중이 아님"

#: ui/main.qml:67
#, kde-format
msgid "No accounts configured"
msgstr "설정한 계정 없음"
