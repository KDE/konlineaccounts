#: ui/Account.qml:31
#, kde-format
msgid "Remove"
msgstr "Kendu"

#: ui/Account.qml:41
#, kde-format
msgid "These applications are authorized to use %1:"
msgstr "Aplikazio hauek %1 erabiltzeko baimena dute:"

#: ui/Account.qml:63
#, kde-format
msgid "No applications are authorized to use %1"
msgstr "Ez dago %1 erabiltzeko baimenik duen aplikaziorik"

#: ui/AddAccountDialog.qml:23
#, kde-format
msgid "Create Account"
msgstr "Kontua sortu"

#: ui/App.qml:28
#, kde-format
msgid "Give access to relevant apps:"
msgstr "Dagozkien aplikazioei sarbidea eman:"

#: ui/App.qml:68
#, kde-format
msgid "No relevant apps found"
msgstr "Dagokion aplikaziorik ez da aurkitu"

#: ui/App.qml:74
#, kde-format
msgid "Finish"
msgstr "Amaitu"

#: ui/Error.qml:25
#, kde-format
msgid "Setup failed: %1"
msgstr "Konfigurazioak huts egin du: %1"

#: ui/Error.qml:29
#, kde-format
msgid "Ok"
msgstr "Ados"

#: ui/main.qml:26
#, kde-format
msgid "Add Account…"
msgstr "Kontua gehitu…"

#: ui/main.qml:44
#, kde-kuit-format
msgctxt "@info:usagetip"
msgid ""
"This feature is under development and is still considered experimental. "
"Report all issues <link url='%1'>here</link>."
msgstr ""
"Eginbide hau garatzen ari da eta oraindik esperimentaltzat jotzen da. Arazo "
"guztien berri <link url='%1'>hemen</link> eman."

#: ui/main.qml:60
#, kde-format
msgid "Online accounts service is not running"
msgstr "Lerroko kontuen zerbitzua ez dago martxan"

#: ui/main.qml:67
#, kde-format
msgid "No accounts configured"
msgstr "Ez da konturik konfiguratu"
