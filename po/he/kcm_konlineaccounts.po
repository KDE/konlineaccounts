#: ui/Account.qml:31
#, kde-format
msgid "Remove"
msgstr "הסרה"

#: ui/Account.qml:41
#, kde-format
msgctxt "%1 is the name of an online account"
msgid "These applications are authorized to use %1:"
msgstr "היישומים האלו מורשים להשתמש ב־%1:"

#: ui/Account.qml:63
#, kde-format
msgctxt "%1 is the name of an online account"
msgid "No applications are authorized to use %1"
msgstr "אין יישומים שמורשים להשתמש ב־%1"

#: ui/AddAccountDialog.qml:23
#, kde-format
msgctxt "@title:window"
msgid "Create Account"
msgstr "יצירת חשבון"

#: ui/App.qml:28
#, kde-format
msgctxt "as in 'allow relevant apps to access your account'"
msgid "Give access to relevant apps:"
msgstr "להעניק גישה ליישומים המתאימים:"

#: ui/App.qml:68
#, kde-format
msgid "No relevant apps found"
msgstr "לא נמצאו יישומים מתאימים"

#: ui/App.qml:74
#, kde-format
msgctxt "@action:button"
msgid "Finish"
msgstr "סיום"

#: ui/Error.qml:25
#, kde-format
msgctxt "%1 is an error message"
msgid "Setup failed: %1"
msgstr "ההגדרה נכשלה: %1"

#: ui/Error.qml:29
#, kde-format
msgctxt "@action:button"
msgid "OK"
msgstr "אישור"

#: ui/main.qml:26
#, kde-format
msgid "Add Account…"
msgstr "הוספת חשבון…"

#: ui/main.qml:44
#, kde-kuit-format
msgctxt "@info:usagetip"
msgid ""
"This feature is under development and is still considered experimental. "
"Report all issues <link url='%1'>here</link>."
msgstr ""
"היכולת הזאת בתהליכי פיתוח ועדיין נחשב ניסיונית. יש לדווח על כל הבעיות <link "
"url='%1'>כאן</link>."

#: ui/main.qml:60
#, kde-format
msgid "Online accounts service is not running"
msgstr "שירות החשבונות המקוונים לא פעיל"

#: ui/main.qml:67
#, kde-format
msgid "No accounts configured"
msgstr "לא מוגדרים חשבונות"

#~ msgid "Ok"
#~ msgstr "אישור"
